# Скопируй в .env для локального запуска и заполни своими значениями.
# На Railway эти же имена задаются в разделе Variables сервиса — вводить
# секреты нужно там самостоятельно, через веб-интерфейс Railway.

# Токен бота из @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес задеплоенного сервиса (Railway выдаёт домен вида
# https://<name>.up.railway.app) — используется для кнопок Mini App
WEBAPP_BASE_URL=http://localhost:8000

# ID папки с самой библиотекой (.7z архивы) на Google Drive
GDRIVE_LIBRARY_FOLDER_ID=14s1PKz7GjqsNjr6kzknV7-0hia6JmN0Z

# ID папки с flibusta_catalog.db на личном Drive
GDRIVE_CATALOG_FOLDER_ID=18g1jRjYT_DXBV5ZBBCQ8D7f20WMACbrx

# Только для прод-деплоя (Railway): содержимое ~/.config/rclone/rclone.conf
# в base64 одной строкой. Локально не нужно — rclone.conf уже есть на диске.
RCLONE_CONF_BASE64=

CACHE_DIR=./data/cache
CATALOG_DB_PATH=./data/flibusta_catalog.db
PORT=8000
